<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<%= form_with model: User.new, url: new_options_form_path, method: :post do |form| %>
  <%= form.label "Favorite State", for: "allow-new" %>
  <%= form.combobox :favorite_state_id, State.all, id: "allow-new",
        name_when_new: "user[favorite_state_attributes][name]", value_when_new: "Newplace" %>

  <%= form.submit %>
<% end %>
